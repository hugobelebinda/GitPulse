#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

usage() {
  cat <<'EOF'
Usage: omnidoc <command>

Commands:
  run      Create .env if needed, then build and start the full stack
  status   Show the stack
  logs     Follow logs (optional service name)
  stop     Stop the stack and keep data volumes
EOF
}

ensure_env() {
  if [[ ! -f .env ]]; then
    cp .env.example .env
    echo "Created .env from .env.example"
  fi
}

wait_until_ready() {
  local attempt
  for attempt in $(seq 1 60); do
    local state
    state="$(docker compose ps --format '{{.Service}} {{.Status}}')"
    if grep -q '^ingestion-service Up .*healthy' <<<"$state" && grep -q '^worker Up' <<<"$state"; then
      return 0
    fi
    sleep 2
  done
  echo "The stack did not become ready in time." >&2
  docker compose ps
  return 1
}

cmd_run() {
  ensure_env
  docker compose up -d --build
  wait_until_ready
  cat <<'EOF'

OmniDoc AI is up.

  Open       http://localhost:8080
  Health     http://localhost:8080/actuator/health
  MinIO      http://localhost:9001
  RabbitMQ   http://localhost:15672

Open the page, choose a PDF, and the summary appears there.
EOF
}

cmd_status() {
  docker compose ps
}

cmd_logs() {
  docker compose logs -f "$@"
}

cmd_stop() {
  docker compose down
}

command="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command" in
  run) cmd_run "$@" ;;
  status) cmd_status "$@" ;;
  logs) cmd_logs "$@" ;;
  stop) cmd_stop "$@" ;;
  ""|-h|--help|help) usage ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 1
    ;;
esac
