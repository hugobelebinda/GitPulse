POSTGRES_PASSWORD=gitpulse_dev_password
MINIO_ROOT_USER=gitpulse
MINIO_ROOT_PASSWORD=gitpulse_dev_password
DATABASE_URL=postgresql+psycopg://gitpulse:gitpulse_dev_password@localhost:5432/gitpulse
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=gitpulse-raw
MINIO_SECURE=false
GITPULSE_DATA_DIR=data
GITPULSE_RESULTS_PATH=ds/results.json
CLICKHOUSE_URL=https://play.clickhouse.com/?user=explorer&default_format=JSONEachRow
GHARCHIVE_BASE_URL=https://data.gharchive.org
GITPULSE_REFRESH_INTERVAL_SECONDS=86400
GITPULSE_BACKFILL_DAYS=14
GITPULSE_HOLDOUT_DAYS=30
