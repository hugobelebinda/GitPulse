# Local development defaults for OmniDoc AI Phase 1.
# Copy this file to .env before running docker compose.
# These credentials are for the local Docker stack only.

# MongoDB
MONGO_INITDB_ROOT_USERNAME=omnidoc
MONGO_INITDB_ROOT_PASSWORD=omnidoc_dev_password
MONGO_INITDB_DATABASE=omnidoc
MONGO_PORT=27017

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=omnidoc
MINIO_ROOT_PASSWORD=omnidoc_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=omnidoc-documents

# RabbitMQ
# RABBITMQ_DEFAULT_USER and RABBITMQ_DEFAULT_PASS must match infra/rabbitmq/definitions.json.
# RabbitMQ skips its default-user bootstrap when definitions are loaded at startup.
RABBITMQ_DEFAULT_USER=omnidoc
RABBITMQ_DEFAULT_PASS=omnidoc_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_QUEUE=document-processing-queue
