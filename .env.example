# Local development defaults for OmniDoc AI Phase 1.
# Copy this file to .env before running docker compose.
# These credentials are for the local Docker stack only.

# MongoDB
MONGO_INITDB_ROOT_USERNAME=omnidoc
MONGO_INITDB_ROOT_PASSWORD=omnidoc_dev_password
MONGO_INITDB_DATABASE=omnidoc
MONGO_PORT=27017

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=omnidoc
MINIO_ROOT_PASSWORD=omnidoc_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=omnidoc-documents

# RabbitMQ
# RABBITMQ_DEFAULT_USER and RABBITMQ_DEFAULT_PASS must match infra/rabbitmq/definitions.json.
# RabbitMQ skips its default-user bootstrap when definitions are loaded at startup.
RABBITMQ_DEFAULT_USER=omnidoc
RABBITMQ_DEFAULT_PASS=omnidoc_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_QUEUE=document-processing-queue

# Ingestion service (runs on the host in Phase 2)
SERVER_PORT=8080
MONGODB_URI=mongodb://omnidoc:omnidoc_dev_password@localhost:27017/omnidoc?authSource=admin
MINIO_ENDPOINT=http://localhost:9000
RABBITMQ_HOST=localhost
MAX_UPLOAD_SIZE=25MB

# Python worker (Phase 3)
TESSERACT_LANG=eng
OCR_MIN_PAGE_CHARS=20
WORKER_MAX_RETRIES=3
LOG_LEVEL=INFO
SUMMARY_MODEL=bartowski/Qwen2.5-7B-Instruct-GGUF
SUMMARY_MODEL_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf
NER_MODEL=nickprock/bert-finetuned-ner-ontonotes
NER_SCORE_THRESHOLD=0.5
NER_DEVICE=cpu
